# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------- database
# The role, database and password you create in pgAdmin (see db/SETUP.md).
PGHOST=localhost
PGPORT=5432
PGDATABASE=maternalcare
PGUSER=maternalcare
PGPASSWORD=

# Alternatively give a single connection string, which overrides the five
# variables above. This is the form most hosts hand you when you deploy.
# DATABASE_URL=postgresql://user:password@host:5432/maternalcare

# ------------------------------------------------------------------ server
PORT=3000

# Comma-separated origins allowed to call /api. Leave unset in development
# and the dev ports plus private-network addresses are accepted.
# CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
