# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------- database
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use the SESSION POOLER (port 5432). The direct connection is IPv6-only on
# the free tier, and the transaction pooler (6543) drops prepared statements.
DATABASE_URL=

# ------------------------------------------------------------------ server
PORT=3000

# Comma-separated origins allowed to call /api. Leave unset in development
# and the dev ports plus private-network addresses are accepted.
# CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# ------------------------------------------------- risk model service (F13)
# The FastAPI classifier in ml-service/. Optional: the app falls back to the
# rule engine when this is unreachable, so leaving it unset is fine.
ML_SERVICE_URL=http://localhost:8000
# How long to wait before giving up on it, in milliseconds.
ML_TIMEOUT_MS=2500
