<%- include('partials/head', { title: 'Appointments' }) %>
<%- include('partials/shell-start', {
      heading: 'Appointments & Doctors',
      sub: 'Find specialists, book consultations and manage your visits',
      toast: booked ? 'Appointment booked successfully' : null }) %>

<% const fmt = d => new Date(d + 'T00:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
   const docColors = ['linear-gradient(135deg,#f0568c,#c04cb8)', 'linear-gradient(135deg,#7c5cf0,#5a8df0)',
                      'linear-gradient(135deg,#23b8a6,#3ec9e0)', 'linear-gradient(135deg,#ff9d6c,#f5a623)']; %>

<div class="card reveal">
  <div class="card-head" style="margin-bottom:0">
    <div>
      <div class="card-title"><span class="ico">🎯</span> Who to see first</div>
      <div class="card-sub">
        Ranked for you — what they are qualified in, whether they have room,
        how fast they answer and how they are rated, weighed together. Nothing
        to filter: every card says why it sits where it does.
      </div>
    </div>
  </div>
</div>

<div class="grid grid-3 mt">
  <% doctors.forEach((d, i) => { %>
    <div class="card hoverable doc-card reveal <%= i % 3 === 1 ? 'reveal-d1' : i % 3 === 2 ? 'reveal-d2' : '' %>">
      <div class="doc-top">
        <div class="doc-pic" style="background:<%= docColors[i % 4] %>"><%= d.name.replace('Dr. ','').split(' ').map(w=>w[0]).join('').slice(0,2) %></div>
        <div>
          <b style="font-size:14.5px"><%= d.name %></b>
          <div style="font-size:12px; color:var(--ink-3); font-weight:600"><%= d.specialty %></div>
        </div>
        <% if (i === 0 && d.tier === 0) { %><div class="right"><span class="pill pill-good">Best match</span></div><% } %>
      </div>
      <div class="doc-meta">
        <% if (d.rating != null) { %>
          <span class="pill pill-neutral">⭐ <%= d.rating %></span>
        <% } else { %>
          <span class="pill pill-neutral">New here</span>
        <% } %>
        <span class="pill <%= d.bookable ? 'pill-good' : 'pill-warning' %>">
          <%= d.status === 'open' ? '● Taking requests'
            : d.status === 'busy' ? '● Nearly full'
            : d.status === 'full' ? '● List full' : '● On leave' %>
        </span>
      </div>
      <div style="font-size:12.5px; color:var(--ink-2); font-weight:600">🎓 <%= d.qualification || 'Qualifications not listed' %></div>
      <ul style="margin:0; padding-left:16px; font-size:12px; color:var(--ink-3); font-weight:600; line-height:1.7">
        <% for (const r of d.reasons.slice(0, 3)) { %><li><%= r %></li><% } %>
      </ul>
      <% if (d.bookable) { %>
        <form method="POST" action="/appointments" style="display:flex; gap:9px; margin-top:2px">
          <input type="hidden" name="doctor_id" value="<%= d.id %>">
          <input type="hidden" name="reason" value="Consultation with <%= d.name %>">
          <input type="date" name="date" class="field" required
                 style="flex:1; padding:9px 12px; border-radius:12px; border:1px solid var(--glass-border-2); background:rgba(255,255,255,0.7); font-size:12.5px"
                 value="<%= new Date(Date.now() + 3*86400000).toISOString().slice(0,10) %>" min="<%= new Date().toISOString().slice(0,10) %>">
          <button class="btn btn-primary btn-sm">Book</button>
        </form>
      <% } %>
    </div>
  <% }) %>
</div>

<div class="card mt reveal">
  <div class="card-head">
    <div>
      <div class="card-title"><span class="ico">📒</span> My appointments</div>
      <div class="card-sub">Upcoming and past consultations — your digital medical history</div>
    </div>
  </div>
  <div class="table-wrap">
    <table class="glass-table">
      <thead><tr><th>Date</th><th>Time</th><th>Doctor</th><th>Reason</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% for (const a of appointments) { %>
          <tr>
            <td><%= fmt(a.date) %></td>
            <td><%= a.time %></td>
            <td><b style="color:var(--ink)"><%= a.doctor_name %></b><br><small style="color:var(--ink-3)"><%= a.specialty %></small></td>
            <td><%= a.reason %></td>
            <td>
              <span class="pill <%= a.status === 'requested' ? 'pill-warning' : a.status === 'accepted' ? 'pill-info' : a.status === 'completed' ? 'pill-good' : 'pill-neutral' %>">
                <%= a.status === 'requested' ? '⏳ Awaiting reply'
                  : a.status === 'accepted' ? '🗓️ Upcoming'
                  : a.status === 'completed' ? '✓ Completed'
                  : a.status === 'declined' ? '✕ Declined' : '✕ Cancelled' %>
              </span>
            </td>
            <td style="text-align:right">
              <% if (a.status === 'accepted' || a.status === 'requested') { %>
                <form method="POST" action="/appointments/<%= a.id %>/cancel" style="display:inline">
                  <button class="btn btn-ghost btn-sm">Cancel</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/shell-end') %>
