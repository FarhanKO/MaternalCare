{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000
    },
    {
      "name": "ml",
      "runtimeExecutable": "ml-service/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app:app", "--port", "8000", "--app-dir", "ml-service"],
      "port": 8000
    }
  ]
}
