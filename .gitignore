# dependencies
node_modules/
frontend/node_modules/

# build output
frontend/dist/
dist/
*.tsbuildinfo

# database (regenerated + seeded on first run)
data/*.db
data/*.db-shm
data/*.db-wal

# uploaded prescriptions and reports — patient data, never committed
data/uploads/

# environment
.env
.env.local
frontend/.env.local

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*

# The guardian APK is delivered here by the Guardian MaternityCare+ project
# (npm run apk over there). A build artifact, so it is not committed.
public/downloads/*.apk

# seeded design canvases are published artifacts, not source
design/**/*.html
!design/**/*.dc.html
