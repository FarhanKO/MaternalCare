<%- include('partials/head', { title: 'Pregnancy Tracker' }) %>
<%- include('partials/shell-start', {
      heading: 'Pregnancy Journey',
      sub: `Automatically tracked from your LMP · trimester ${pregnancy.trimester} of 3`,
      toast: null }) %>

<div class="grid grid-3">
  <div class="card hoverable col-span-2 reveal" style="background:linear-gradient(150deg, rgba(253,224,236,0.8), rgba(221,212,251,0.7)); overflow:hidden">
    <div style="display:flex; gap:26px; align-items:center; flex-wrap:wrap">
      <div style="font-size:96px; filter:drop-shadow(0 16px 26px rgba(90,70,150,0.3)); animation:floaty 6s ease-in-out infinite">🤰</div>
      <div style="flex:1; min-width:220px">
        <span class="pill pill-violet">Trimester <%= pregnancy.trimester %></span>
        <h2 style="font-size:33px; font-weight:800; letter-spacing:-0.03em; margin:10px 0 4px">
          Week <%= pregnancy.week %><span style="font-size:16px; color:var(--ink-2); font-weight:700"> + <%= pregnancy.dayOfWeek %> days</span>
        </h2>
        <p style="font-size:13.5px; color:var(--ink-2); line-height:1.6; max-width:420px"><%= pregnancy.weekNote %></p>
        <div class="progress" style="margin:16px 0 8px; max-width:420px"><span data-w="<%= pregnancy.progress %>"></span></div>
        <div style="display:flex; justify-content:space-between; max-width:420px; font-size:11.5px; font-weight:700; color:var(--ink-3)">
          <span>Conception</span><span><%= pregnancy.progress %>% complete</span><span>Birth 👶</span>
        </div>
      </div>
    </div>
  </div>

  <div class="card hoverable reveal reveal-d1">
    <div class="card-head">
      <div><div class="card-title"><span class="ico">🗓️</span> Key dates</div></div>
    </div>
    <div class="row-item"><div class="row-ico tint-rose">🌱</div>
      <div><b>Last menstrual period</b><small><%= new Date(pregnancy.lmp + 'T00:00:00').toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }) %></small></div></div>
    <div class="row-item"><div class="row-ico tint-violet">🎯</div>
      <div><b>Estimated delivery</b><small><%= pregnancy.eddPretty %></small></div></div>
    <div class="row-item"><div class="row-ico tint-aqua">⏳</div>
      <div><b>Days remaining</b><small><%= pregnancy.daysLeft %> days to go</small></div></div>
    <div class="alert alert-good" style="margin-top:10px">
      <span class="aico">💡</span>
      <div>EDD is calculated as LMP + 280 days using Naegele's rule.</div>
    </div>
  </div>
</div>

<div class="grid grid-3 mt">
  <div class="card hoverable reveal">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico"><%= pregnancy.babySize.emoji %></span> Baby this week</div>
        <div class="card-sub">Approximate size &amp; weight</div>
      </div>
    </div>
    <div style="text-align:center; padding:8px 0">
      <div style="font-size:64px; filter:drop-shadow(0 12px 18px rgba(90,70,150,0.25))"><%= pregnancy.babySize.emoji %></div>
      <div style="font-weight:800; font-size:18px; margin-top:10px"><%= pregnancy.babySize.fruit %></div>
      <div style="display:flex; justify-content:center; gap:10px; margin-top:12px">
        <span class="pill pill-violet">📏 <%= pregnancy.babySize.length %></span>
        <span class="pill pill-violet">⚖️ <%= pregnancy.babySize.weight %></span>
      </div>
    </div>
    <div class="row-item" style="margin-top:8px"><div class="row-ico tint-aqua">👂</div>
      <div><b>Hearing</b><small>Baby recognises your voice</small></div></div>
    <div class="row-item"><div class="row-ico tint-rose">👀</div>
      <div><b>Eyes</b><small>Opening for the first time this week</small></div></div>
    <div class="row-item"><div class="row-ico tint-peach">🫁</div>
      <div><b>Lungs</b><small>Practising breathing movements</small></div></div>
  </div>

  <div class="card hoverable reveal reveal-d1">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">🛤️</span> Care timeline</div>
        <div class="card-sub">Checkpoints on your journey</div>
      </div>
    </div>
    <div class="timeline">
      <% for (const t of timeline) { %>
        <div class="tl-item <%= t.state %>">
          <div class="tl-dot"><%= t.state === 'done' ? '✓' : t.icon %></div>
          <div class="tl-body">
            <b>Week <%= t.week %> · <%= t.label %></b>
            <small><%= t.state === 'done' ? 'Completed' : t.state === 'now' ? 'This week — book if not done' : 'Coming up' %></small>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card hoverable reveal reveal-d2">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">💜</span> This week's care tips</div>
        <div class="card-sub">Personalised for week <%= pregnancy.week %></div>
      </div>
    </div>
    <div class="row-item"><div class="row-ico tint-aqua">🥗</div>
      <div><b>Iron &amp; calcium up</b><small>Add lentils, spinach and dairy daily</small></div></div>
    <div class="row-item"><div class="row-ico tint-violet">🧪</div>
      <div><b>Glucose screening</b><small>Recommended between weeks 24–28</small></div></div>
    <div class="row-item"><div class="row-ico tint-rose">🦶</div>
      <div><b>Kick counting begins soon</b><small>Start daily counts from week 28</small></div></div>
    <div class="row-item"><div class="row-ico tint-peach">😴</div>
      <div><b>Sleep on your left</b><small>Improves blood flow to your baby</small></div></div>
    <a href="/learn" class="btn btn-glass btn-sm" style="margin-top:12px; width:100%">📚 Read week <%= pregnancy.week %> guide</a>
  </div>
</div>

<%- include('partials/shell-end') %>
