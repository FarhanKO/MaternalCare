<%- include('partials/head', { title: 'Pregnancy Tracker' }) %>
<%- include('partials/shell-start', {
      heading: 'Pregnancy Journey',
      sub: `Automatically tracked from your LMP · trimester ${pregnancy.trimester} of 3`,
      toast: null }) %>

<div class="grid grid-3">
  <div class="card hoverable col-span-2 reveal" style="background:linear-gradient(150deg, rgba(253,224,236,0.8), rgba(221,212,251,0.7)); overflow:hidden">
    <div style="display:flex; gap:26px; align-items:center; flex-wrap:wrap">
      <div style="font-size:96px; filter:drop-shadow(0 16px 26px rgba(90,70,150,0.3)); animation:floaty 6s ease-in-out infinite">🤰</div>
      <div style="flex:1; min-width:220px">
        <span class="pill pill-violet">Trimester <%= pregnancy.trimester %></span>
        <h2 style="font-size:33px; font-weight:800; letter-spacing:-0.03em; margin:10px 0 4px">
          Week <%= pregnancy.week %><span style="font-size:16px; color:var(--ink-2); font-weight:700"> + <%= pregnancy.dayOfWeek %> days</span>
        </h2>
        <p style="font-size:13.5px; color:var(--ink-2); line-height:1.6; max-width:420px"><%= pregnancy.weekNote %></p>
        <div class="progress" style="margin:16px 0 8px; max-width:420px"><span data-w="<%= pregnancy.progress %>"></span></div>
        <div style="display:flex; justify-content:space-between; max-width:420px; font-size:11.5px; font-weight:700; color:var(--ink-3)">
          <span>Conception</span><span><%= pregnancy.progress %>% complete</span><span>Birth 👶</span>
        </div>
      </div>
    </div>
  </div>

