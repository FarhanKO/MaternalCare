<%- include('partials/head', { title: 'Dashboard' }) %>
<%- include('partials/shell-start', {
      heading: `Good day, ${user.name.split(' ')[0]} 🌸`,
      sub: `Week ${pregnancy.week} of your pregnancy · ${pregnancy.daysLeft} days until you meet your baby`,
      toast: null }) %>

<% const fmt = d => new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); %>

<% if (alerts.length) { %>
  <div class="grid" style="margin-bottom:22px">
    <% for (const a of alerts) { %>
      <div class="alert alert-<%= a.level %> reveal in">
        <span class="aico"><%= a.level === 'critical' ? '⛔' : '⚠️' %></span>
        <div><b><%= a.metric %> — <%= a.value %></b><%= a.message %></div>
      </div>
    <% } %>
  </div>
<% } %>

<div class="grid grid-4">
  <div class="card hoverable reveal">
    <div class="stat-ico tint-rose">🤰</div>
    <div class="stat">
      <span class="k">Pregnancy progress</span>
      <span class="v">Week <%= pregnancy.week %> <small>· T<%= pregnancy.trimester %></small></span>
      <div class="progress" style="margin:9px 0 7px"><span data-w="<%= pregnancy.progress %>"></span></div>
      <span class="d">EDD · <%= pregnancy.eddPretty %></span>
    </div>
  </div>

  <div class="card hoverable reveal reveal-d1">
    <div class="stat-ico tint-violet">🫀</div>
    <div class="stat">
      <span class="k">Latest blood pressure</span>
      <span class="v"><%= latest.systolic %>/<%= latest.diastolic %> <small>mmHg</small></span>
      <span class="d <%= latest.systolic >= 130 ? 'watch' : 'up' %>">
        <%= latest.systolic >= 130 ? '● Elevated — monitor daily' : '● Within normal range' %>
      </span>
    </div>
  </div>

  <div class="card hoverable reveal reveal-d2">
    <div class="stat-ico tint-aqua">👶</div>
    <div class="stat">
      <span class="k"><%= child.name %>'s age</span>
      <span class="v"><%= child.ageMonths %> <small>months</small></span>
      <span class="d up">● Growing along the healthy band</span>
    </div>
  </div>

  <div class="card hoverable reveal reveal-d3">
    <div class="stat-ico tint-peach">💉</div>
    <div class="stat">
      <span class="k">Vaccination compliance</span>
      <span class="v"><%= vaxStats.pct %><small>%</small></span>
      <div class="progress aqua" style="margin:9px 0 7px"><span data-w="<%= vaxStats.pct %>"></span></div>
      <span class="d"><%= vaxStats.done %> of <%= vaxStats.total %> doses completed</span>
    </div>
  </div>
</div>

<div class="grid grid-3 mt">
  <div class="card hoverable col-span-2 reveal">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">📈</span> Blood pressure trend</div>
        <div class="card-sub">Weekly readings · dashed line marks the 140 mmHg safe limit</div>
      </div>
      <div class="right"><a href="/vitals" class="btn btn-glass btn-sm">Log today's vitals</a></div>
    </div>
    <div class="chart-box" style="height:250px"><canvas id="sparkChart"></canvas></div>
  </div>

  <div class="card hoverable reveal reveal-d1">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">🧠</span> AI risk insight</div>
        <div class="card-sub">From your latest vitals</div>
      </div>
    </div>
    <div class="chart-box" style="height:150px"><canvas id="riskGauge"></canvas></div>
    <div style="text-align:center; margin-top:-58px; position:relative; pointer-events:none">
      <div style="font-size:25px; font-weight:800; letter-spacing:-0.02em"><%= risk.score %></div>
      <div style="font-size:10.5px; color:var(--ink-3); font-weight:700">RISK SCORE</div>
    </div>
    <div style="text-align:center; margin-top:22px">
      <span class="pill pill-<%= risk.level === 'low' ? 'good' : risk.level === 'medium' ? 'warning' : 'critical' %>">
        <%= risk.level === 'low' ? '🟢' : risk.level === 'medium' ? '🟡' : '🔴' %> <%= risk.label %>
      </span>
      <p style="font-size:12px; color:var(--ink-2); margin-top:12px; line-height:1.55">
        <%= risk.level === 'low' ? 'Everything looks steady. Keep logging vitals and rest well.'
          : risk.level === 'medium' ? 'Some readings need attention — see your personalised plan.'
          : 'Please contact your doctor today for a professional review.' %>
      </p>
      <a href="/risk" class="btn btn-primary btn-sm" style="margin-top:10px">View full report</a>
    </div>
  </div>
</div>

<div class="grid grid-3 mt">
  <div class="card hoverable reveal">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">🗓️</span> Upcoming appointments</div>
        <div class="card-sub">Next consultations</div>
      </div>
      <div class="right"><a href="/appointments" class="btn btn-ghost btn-sm">All →</a></div>
    </div>
    <% for (const a of appointments) { %>
      <div class="row-item">
        <div class="row-ico tint-violet">🩺</div>
        <div><b><%= a.doctor_name %></b><small><%= a.reason %></small></div>
        <div class="right"><b style="font-size:12.5px"><%= fmt(a.date) %></b><small><%= a.time %></small></div>
      </div>
    <% } %>
  </div>

  <div class="card hoverable reveal reveal-d1">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">💉</span> Next vaccinations</div>
        <div class="card-sub">Smart reminders active</div>
      </div>
      <div class="right"><a href="/vaccinations" class="btn btn-ghost btn-sm">All →</a></div>
    </div>
    <% for (const v of nextVax) { %>
      <div class="row-item">
        <div class="row-ico tint-peach"><%= v.subject === 'child' ? '👶' : '🤰' %></div>
        <div><b><%= v.name %></b><small><%= v.dose %> · <%= v.subject === 'child' ? child.name : 'Mother' %></small></div>
        <div class="right">
          <span class="pill <%= v.status === 'due' ? 'pill-critical' : 'pill-info' %>"><%= fmt(v.due_date) %></span>
        </div>
      </div>
    <% } %>
    <div class="alert alert-good" style="margin-top:12px">
      <span class="aico">🔔</span>
      <div>Reminders will be sent 3 days and 1 day before each due date.</div>
    </div>
  </div>

  <div class="card hoverable reveal reveal-d2" style="background:linear-gradient(155deg, rgba(253,224,236,0.75), rgba(221,212,251,0.65)); overflow:hidden">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico" style="background:rgba(255,255,255,0.6)"><%= pregnancy.babySize.emoji %></span> Your baby this week</div>
        <div class="card-sub">Week <%= pregnancy.week %> highlights</div>
      </div>
    </div>
    <div style="text-align:center; padding:6px 0 2px">
      <div style="font-size:58px; filter:drop-shadow(0 12px 18px rgba(90,70,150,0.25))"><%= pregnancy.babySize.emoji %></div>
      <div style="font-weight:800; font-size:17px; margin-top:8px">Size of a <%= pregnancy.babySize.fruit.toLowerCase() %></div>
      <div style="display:flex; justify-content:center; gap:10px; margin-top:12px">
        <span class="pill pill-violet">📏 <%= pregnancy.babySize.length %></span>
        <span class="pill pill-violet">⚖️ <%= pregnancy.babySize.weight %></span>
      </div>
      <p style="font-size:12.5px; color:var(--ink-2); line-height:1.6; margin-top:14px"><%= pregnancy.weekNote %></p>
    </div>
  </div>
</div>

<script>
  window.MC = {
    vitals: {
      labels: <%- JSON.stringify(vitals.map(v => fmt(v.date))) %>,
      systolic: <%- JSON.stringify(vitals.map(v => v.systolic)) %>,
      diastolic: <%- JSON.stringify(vitals.map(v => v.diastolic)) %>
    },
    risk: { score: <%= risk.score %>, level: '<%= risk.level %>' }
  };
</script>

<%- include('partials/shell-end') %>
