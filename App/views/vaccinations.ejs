<%- include('partials/head', { title: 'Vaccinations' }) %>
<%- include('partials/shell-start', {
      heading: 'Vaccination Schedule 💉',
      sub: `Immunisation timelines for ${child.name} and mother, with smart reminders`,
      toast: null }) %>

<% const fmt = d => new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); %>

<div class="grid grid-3">
  <div class="card hoverable reveal">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">🛡️</span> Coverage overview</div>
        <div class="card-sub">All scheduled doses</div>
      </div>
    </div>
    <div class="chart-box" style="height:210px"><canvas id="vaxChart"></canvas></div>
    <div style="text-align:center; margin-top:14px">
      <span style="font-size:26px; font-weight:800; letter-spacing:-0.02em"><%= stats.pct %>%</span>
      <div style="font-size:11.5px; color:var(--ink-3); font-weight:700">SCHEDULE COMPLETED</div>
    </div>
  </div>

  <div class="card hoverable col-span-2 reveal reveal-d1">
    <div class="card-head">
      <div>
        <div class="card-title"><span class="ico">🗂️</span> Digital vaccination record</div>
        <div class="card-sub">Mark doses complete — reminders are generated automatically</div>
      </div>
      <div class="right">
        <span class="pill pill-critical"><%= stats.due %> due</span>
        <span class="pill pill-info" style="margin-left:6px"><%= stats.upcoming %> upcoming</span>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; gap:4px">
      <% for (const v of vaccinations) { %>
        <div class="row-item" style="<%= v.status === 'due' ? 'background:rgba(208,59,59,0.06); border:1px solid rgba(208,59,59,0.16)' : '' %>">
          <div class="row-ico <%= v.subject === 'child' ? 'tint-aqua' : 'tint-rose' %>"><%= v.subject === 'child' ? '👶' : '🤰' %></div>
          <div>
            <b><%= v.name %></b>
            <small><%= v.dose %> · <%= v.subject === 'child' ? child.name : 'Mother' %> ·
              <%= v.status === 'done' ? 'Given ' + fmt(v.completed_on) : 'Due ' + fmt(v.due_date) %></small>
          </div>
          <div class="right">
            <% if (v.status === 'done') { %>
              <span class="pill pill-good">✓ Completed</span>
            <% } else { %>
              <span class="pill <%= v.status === 'due' ? 'pill-critical' : 'pill-info' %>" style="margin-right:8px">
                <%= v.status === 'due' ? '⏰ Due now' : '🔔 Reminder set' %>
              </span>
              <form method="POST" action="/vaccinations/<%= v.id %>/done" style="display:inline">
                <button class="btn btn-glass btn-sm">Mark done</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="grid grid-3 mt">
  <div class="card hoverable reveal">
    <div class="card-head"><div><div class="card-title"><span class="ico">🔔</span> Smart reminders</div></div></div>
    <p style="font-size:13px; color:var(--ink-2); line-height:1.65">
      Notifications are sent <b>3 days before</b> and <b>on the morning of</b> each due date —
      to you and to linked caregivers. Missed doses are automatically rescheduled with your pediatrician's guidance.
    </p>
    <div class="alert alert-warning" style="margin-top:12px">
      <span class="aico">⏰</span>
      <div><b>Influenza (seasonal) — due in 5 days</b>Recommended during pregnancy in any trimester.</div>
    </div>
  </div>
  <div class="card hoverable reveal reveal-d1">
    <div class="card-head"><div><div class="card-title"><span class="ico">📤</span> Vaccine card upload</div></div></div>
    <p style="font-size:13px; color:var(--ink-2); line-height:1.65">
      Keep official vaccine cards and supporting documents attached to each dose for doctor visits and travel.
    </p>
    <label class="btn btn-glass" style="margin-top:14px; width:100%; border-style:dashed; border-color:rgba(124,92,240,0.35)">
      📎 Upload card (PDF / photo)
      <input type="file" hidden onchange="showToast('Document attached to your record', '📎')">
    </label>
  </div>
