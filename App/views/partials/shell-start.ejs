<body<%= typeof toast !== 'undefined' && toast ? ` data-toast="${toast}"` : '' %>>
<div class="scene"></div>
<div class="blob blob-1"></div>
<div class="blob blob-2"></div>
<div class="blob blob-3"></div>

<div class="shell">
  <%
    const icons = {
      dashboard: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7.5" height="9" rx="2"/><rect x="13.5" y="3" width="7.5" height="5.5" rx="2"/><rect x="13.5" y="12" width="7.5" height="9" rx="2"/><rect x="3" y="15.5" width="7.5" height="5.5" rx="2"/></svg>',
      pregnancy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7.5-4.6-9.5-9C1 8.5 3 5 6.5 5c2 0 3.6 1.2 4.5 2.5h2C13.9 6.2 15.5 5 17.5 5 21 5 23 8.5 21.5 12c-2 4.4-9.5 9-9.5 9z" transform="translate(0 -0.5) scale(0.98)"/></svg>',
      vitals: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2.5-6 4 12 2.5-6h5"/></svg>',
      child: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="10.5" r="0.6" fill="currentColor"/><circle cx="15" cy="10.5" r="0.6" fill="currentColor"/><path d="M9 15c.9.9 1.9 1.3 3 1.3s2.1-.4 3-1.3"/><path d="M12 3c1.2.8 1.6 2 1 3"/></svg>',
      vaccinations: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.6-3 8.6-7 10-4-1.4-7-5.4-7-10V6l7-3z"/><path d="M9.5 12l2 2 3.5-4"/></svg>',
      appointments: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="16" rx="3"/><path d="M8 3v4M16 3v4M3.5 10h17"/></svg>',
      risk: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.3L18 9l-4.3 1.7L12 15l-1.7-4.3L6 9l4.3-1.7L12 3z"/><path d="M18.5 15l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1z"/></svg>',
      emergency: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9.5 16.5h-19L12 3z"/><path d="M12 10v4M12 17.2v.3"/></svg>',
      learn: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A2.5 2.5 0 016.5 3H20v15.5H6.5A2.5 2.5 0 004 21V5.5z"/><path d="M4 18.5A2.5 2.5 0 016.5 16H20"/></svg>',
      doctor: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3v6a5 5 0 0010 0V3"/><path d="M10 14v2.5a4.5 4.5 0 009 0V14"/><circle cx="19" cy="11.5" r="2"/></svg>',
    };
    const nav = [
      ['dashboard', '/dashboard', 'Dashboard'],
      ['pregnancy', '/pregnancy', 'Pregnancy'],
      ['vitals', '/vitals', 'Health Vitals'],
      ['child', '/child', 'Child Growth'],
      ['vaccinations', '/vaccinations', 'Vaccinations'],
      ['appointments', '/appointments', 'Appointments'],
      ['risk', '/risk', 'AI Risk Insight'],
    ];
    const nav2 = [
      ['emergency', '/emergency', 'Emergency SOS'],
      ['learn', '/learn', 'Learn & Community'],
      ['doctor', '/doctor', 'Doctor Portal'],
    ];
  %>
  <aside class="sidebar">
    <a class="brand" href="/">
      <div class="brand-mark">🤍</div>
      <div>
        <div class="brand-name">Maternity<span>Care+</span></div>
        <div class="brand-sub">Mother &amp; child health</div>
      </div>
    </a>

    <div class="nav-label">Care</div>
    <% for (const [key, href, label] of nav) { %>
      <a class="nav-item <%= page === key ? 'active' : '' %>" href="<%= href %>">
        <%- icons[key] %><span><%= label %></span>
      </a>
    <% } %>
    <div class="nav-label">Support</div>
    <% for (const [key, href, label] of nav2) { %>
      <a class="nav-item <%= page === key ? 'active' : '' %>" href="<%= href %>">
        <%- icons[key] %><span><%= label %></span>
        <% if (key === 'emergency') { %><span class="dot"></span><% } %>
      </a>
    <% } %>

    <div class="sidebar-cta">
      <div class="emoji">🍼</div>
      <p>Week-by-week guidance, reminders and AI insight — all in one place.</p>
      <a href="/risk" class="btn btn-primary btn-sm">Check my risk</a>
    </div>
  </aside>
  <main class="main">
    <div class="topbar">
      <button class="menu-btn" aria-label="Menu">☰</button>
      <div class="page-title">
        <h1><%= heading %></h1>
        <p><%= sub %></p>
      </div>
      <div class="topbar-right">
        <div class="chip-date">📅 <%= new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></div>
        <a class="avatar" href="/dashboard">
          <div class="avatar-pic"><%= user.name.split(' ').map(w => w[0]).join('').slice(0,2) %></div>
          <div><b><%= user.name %></b><small><%= user.role === 'mother' ? 'Mother · Week view' : user.role %></small></div>
        </a>
      </div>
    </div>
